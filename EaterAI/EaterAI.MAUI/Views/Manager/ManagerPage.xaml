<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EaterAI.MAUI.ViewModels.Manager"
             xmlns:dto="clr-namespace:EaterAI.Shared.DTOs.Manager;assembly=EaterAI.Shared"
             xmlns:converters="clr-namespace:EaterAI.MAUI.Converters"
             x:Class="EaterAI.MAUI.Views.Manager.ManagerPage"
             x:DataType="vm:ManagerViewModel"
             Title="Add Dish">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="All Dishes" Clicked="OnViewAllClicked" />
        <ToolbarItem Text="Logout" Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Restaurant picker -->
            <Label Text="Restaurant" FontAttributes="Bold" />
            <Picker Title="Select restaurant"
                    ItemsSource="{Binding Restaurants}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedRestaurant}" />

            <!-- Photo -->
            <Label Text="Dish Photo" FontAttributes="Bold" Margin="0,8,0,0" />
            <Border WidthRequest="220" HeightRequest="220"
                    HorizontalOptions="Center"
                    Stroke="Gray" StrokeThickness="1">
                <Image Source="{Binding ImageSource}"
                       Aspect="AspectFill"
                       WidthRequest="220" HeightRequest="220" />
            </Border>

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Pick Photo" Command="{Binding PickPhotoCommand}" />
                <Button Text="Take Photo" Command="{Binding TakePhotoCommand}" />
            </HorizontalStackLayout>

            <!-- Price -->
            <Label Text="Price (¥)" FontAttributes="Bold" />
            <Entry Placeholder="0.00" Text="{Binding Price}" Keyboard="Numeric" />

            <!-- Analyze -->
            <Button Text="Analyze Dish"
                    Command="{Binding AnalyzeCommand}"
                    Margin="0,8,0,0" />

            <ActivityIndicator IsRunning="{Binding IsAnalyzing}"
                               IsVisible="{Binding IsAnalyzing}"
                               HorizontalOptions="Center" />

            <!-- Results section -->
            <VerticalStackLayout IsVisible="{Binding HasResult}" Spacing="10" Margin="0,12,0,0">

                <BoxView HeightRequest="1" Color="LightGray" />
                <Label Text="Analysis Result — Edit before adding" FontAttributes="Bold" FontSize="16" />

                <Label Text="Name" FontAttributes="Bold" />
                <Entry Text="{Binding DishName}" />

                <Label Text="Description" FontAttributes="Bold" />
                <Entry Text="{Binding Description}" />

                <!-- Nutrition row -->
                <HorizontalStackLayout Spacing="8">
                    <VerticalStackLayout>
                        <Label Text="Cal" FontSize="12" />
                        <Entry Text="{Binding Calories}" Keyboard="Numeric" WidthRequest="70" />
                    </VerticalStackLayout>
                    <VerticalStackLayout>
                        <Label Text="Protein (g)" FontSize="12" />
                        <Entry Text="{Binding Protein}" Keyboard="Numeric" WidthRequest="80" />
                    </VerticalStackLayout>
                    <VerticalStackLayout>
                        <Label Text="Fat (g)" FontSize="12" />
                        <Entry Text="{Binding Fat}" Keyboard="Numeric" WidthRequest="70" />
                    </VerticalStackLayout>
                    <VerticalStackLayout>
                        <Label Text="Carbs (g)" FontSize="12" />
                        <Entry Text="{Binding Carbs}" Keyboard="Numeric" WidthRequest="80" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Vegan / Spicy -->
                <HorizontalStackLayout Spacing="16">
                    <Label Text="Vegan" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding IsVegan}" />
                    <Label Text="Spicy" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding IsSpicy}" />
                </HorizontalStackLayout>

                <!-- Dish Type -->
                <Label Text="Dish Type" FontAttributes="Bold" />
                <Picker Title="Select dish type"
                        ItemsSource="{Binding Source={x:Static vm:ManagerViewModel.DishTypeOptions}}"
                        SelectedItem="{Binding DishType}" />

                <!-- Ingredients -->
                <Label Text="Ingredients" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding Ingredients}" HeightRequest="140">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:IngredientDto">
                            <Grid ColumnDefinitions="*,Auto" Padding="4,2">
                                <Label Grid.Column="0" Text="{Binding Name}" />
                                <Label Grid.Column="1" Text="{Binding Amount}" TextColor="Gray" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Method -->
                <Label Text="Cooking Method" FontAttributes="Bold" />
                <Editor Text="{Binding Method}"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="120"
                        Placeholder="Step-by-step cooking instructions…" />

                <!-- Add button -->
                <Button Text="Add to Menu"
                        Command="{Binding AddToMenuCommand}"
                        BackgroundColor="Green"
                        TextColor="White"
                        Margin="0,8,0,0" />

            </VerticalStackLayout>

            <!-- Status message -->
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                   TextColor="DarkGreen"
                   HorizontalOptions="Center"
                   Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
