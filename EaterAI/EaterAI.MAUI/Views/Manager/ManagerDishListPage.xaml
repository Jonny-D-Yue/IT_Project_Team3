<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EaterAI.MAUI.ViewModels.Manager"
             xmlns:dto="clr-namespace:EaterAI.Shared.DTOs.Menu;assembly=EaterAI.Shared"
             xmlns:converters="clr-namespace:EaterAI.MAUI.Converters"
             x:Class="EaterAI.MAUI.Views.Manager.ManagerDishListPage"
             x:DataType="vm:ManagerDishListViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="*">

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <CollectionView x:Name="DishList"
                        ItemsSource="{Binding Dishes}"
                        SelectionMode="Single"
                        SelectionChanged="OnDishSelected"
                        IsVisible="{Binding IsBusy, Converter={x:Static converters:BoolConverters.Not}}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:MenuItemDto">
                    <Border Margin="12,4" Padding="12" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Image Grid.Column="0"
                                   Source="{Binding ImageUrl}"
                                   IsVisible="{Binding ImageUrl, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                                   WidthRequest="56" HeightRequest="56"
                                   Aspect="AspectFill" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding RestaurantName}" TextColor="Gray" FontSize="12" />
                                <Label Text="{Binding DishType}" TextColor="SteelBlue" FontSize="11" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding Price, StringFormat='¥{0:F0}'}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
