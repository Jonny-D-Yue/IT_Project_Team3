<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EaterAI.MAUI.ViewModels.Favorites"
             xmlns:dto="clr-namespace:EaterAI.Shared.DTOs.Favorites;assembly=EaterAI.Shared"
             xmlns:converters="clr-namespace:EaterAI.MAUI.Converters"
             x:Class="EaterAI.MAUI.Views.Favorites.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">

        <!-- Create Collection Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,8" ColumnSpacing="8">
            <Entry Grid.Column="0"
                   Placeholder="New collection name..."
                   Text="{Binding NewCollectionName}" />
            <Button Grid.Column="1"
                    Text="Add"
                    Command="{Binding CreateCollectionCommand}"
                    IsEnabled="{Binding IsBusy, Converter={x:Static converters:BoolConverters.Not}}" />
        </Grid>

        <!-- Collections List -->
        <Grid Grid.Row="1">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Collections}"
                            IsVisible="{Binding IsBusy, Converter={x:Static converters:BoolConverters.Not}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:FavoriteCollectionDto">
                        <Border Margin="16,4" Padding="12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCollectionTapped"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding MenuItemIds.Count, StringFormat='{0} items'}"
                                       TextColor="Gray"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </Grid>

</ContentPage>
