<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EaterAI.MAUI.ViewModels.Favorites"
             xmlns:dto="clr-namespace:EaterAI.Shared.DTOs.Menu;assembly=EaterAI.Shared"
             xmlns:converters="clr-namespace:EaterAI.MAUI.Converters"
             x:Class="EaterAI.MAUI.Views.Favorites.CollectionDetailPage"
             x:DataType="vm:CollectionDetailViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="*">
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <CollectionView ItemsSource="{Binding Items}"
                        IsVisible="{Binding IsBusy, Converter={x:Static converters:BoolConverters.Not}}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:MenuItemDto">
                    <Border Margin="16,4" Padding="12" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="15" />
                                <Label Text="{Binding Calories, StringFormat='{0} cal | '}"
                                       TextColor="Gray"
                                       FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding Price, StringFormat='${0:F2}'}"
                                   VerticalOptions="Center"
                                   FontAttributes="Bold" />
                            <Button Grid.Column="2"
                                    Text="Remove"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CollectionDetailViewModel}}, Path=RemoveItemCommand}"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="OrangeRed"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="8,4" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
