<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EaterAI.MAUI.ViewModels.Menu"
             xmlns:conv="clr-namespace:EaterAI.MAUI.Converters"
             x:Class="EaterAI.MAUI.Views.Menu.MenuItemDetailPage"
             x:DataType="vm:MenuItemDetailViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:StringListJoinConverter x:Key="StringListJoin" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding IsBusy, Converter={x:Static conv:BoolConverters.Not}}"
                                 Spacing="12">

                <Image Source="{Binding Item.ImageUrl}"
                       IsVisible="{Binding Item.ImageUrl, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                       Aspect="AspectFit"
                       HeightRequest="200"
                       Margin="0,0,0,4" />

                <Label Text="{Binding Item.Name}"
                       FontSize="26"
                       FontAttributes="Bold" />

                <Label Text="{Binding Item.Description}"
                       TextColor="Gray"
                       FontSize="14" />

                <BoxView HeightRequest="1" Color="LightGray" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                        <Label Text="Price" FontAttributes="Bold" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding Item.Price, StringFormat='${0:F2}'}" FontSize="18" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                        <Label Text="Calories" FontAttributes="Bold" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding Item.Calories, StringFormat='{0} cal'}" FontSize="18" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                        <Label Text="Protein" FontAttributes="Bold" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding Item.Protein, StringFormat='{0:F1}g'}" FontSize="18" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                        <Label Text="Carbs" FontAttributes="Bold" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding Item.Carbs, StringFormat='{0:F1}g'}" FontSize="18" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="LightGray" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Allergens" FontAttributes="Bold" />
                    <Label Text="{Binding Item.Allergens, Converter={StaticResource StringListJoin}}"
                           TextColor="OrangeRed"
                           FontSize="13" />
                </VerticalStackLayout>

                <Label Text="Vegan" TextColor="Green"
                       IsVisible="{Binding Item.IsVegan}"
                       FontAttributes="Bold" />

                <Label Text="Spicy" TextColor="Red"
                       IsVisible="{Binding Item.IsSpicy}"
                       FontAttributes="Bold" />

                <Button Text="Log This Meal"
                        Command="{Binding LogMealCommand}"
                        IsEnabled="{Binding IsBusy, Converter={x:Static conv:BoolConverters.Not}}"
                        Margin="0,16,0,0" />

                <Button Text="Add to Favorites"
                        Command="{Binding AddToFavoritesCommand}"
                        IsEnabled="{Binding IsBusy, Converter={x:Static conv:BoolConverters.Not}}" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
