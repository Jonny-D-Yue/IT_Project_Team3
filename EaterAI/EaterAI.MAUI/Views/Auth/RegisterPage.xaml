<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EaterAI.MAUI.ViewModels.Auth"
             xmlns:enums="clr-namespace:EaterAI.Shared.Enums;assembly=EaterAI.Shared"
             xmlns:converters="clr-namespace:EaterAI.MAUI.Converters"
             x:Class="EaterAI.MAUI.Views.Auth.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Register">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16">

            <Label Text="Create Account"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,16,0,16" />

            <Label Text="Display Name" FontAttributes="Bold" />
            <Entry Placeholder="Display Name"
                   Text="{Binding DisplayName}" />

            <Label Text="Email" FontAttributes="Bold" />
            <Entry Placeholder="Email"
                   Text="{Binding Email}"
                   Keyboard="Email" />

            <Label Text="Password" FontAttributes="Bold" />
            <Entry Placeholder="Password"
                   Text="{Binding Password}"
                   IsPassword="True" />

            <Label Text="Diet Type" FontAttributes="Bold" />
            <Picker Title="Select Diet Type"
                    ItemsSource="{Binding DietTypes}"
                    SelectedItem="{Binding SelectedDietType}" />

            <Label Text="Budget (per meal)" FontAttributes="Bold" />
            <Entry Placeholder="0.00"
                   Text="{Binding Budget}"
                   Keyboard="Numeric" />

            <Label Text="Account Type" FontAttributes="Bold" />
            <Picker Title="Select role"
                    ItemsSource="{Binding RoleOptions}"
                    SelectedItem="{Binding SelectedRoleDisplay}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                   HorizontalOptions="Center" />

            <Button Text="Register"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={x:Static converters:BoolConverters.Not}}"
                    Margin="0,8,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
